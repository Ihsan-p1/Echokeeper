# EchoKeeper Configuration Template

# ── Discord Authentication
# Obtain these from the Discord Developer Portal
DISCORD_TOKEN=your_discard_bot_token_here

# ── Translation Backend
# Options: nllb (local, high quality), opus (cloud HF API)
ECHOKEEPER_BACKEND=nllb

# ── NLLB Configuration (Only used if backend is 'nllb')
# Model options: 
# - facebook/nllb-200-distilled-1.3B (Recommended, ~5.4GB)
# - facebook/nllb-200-distilled-600M (Lighter, ~2.4GB)
NLLB_MODEL_ID=facebook/nllb-200-distilled-1.3B

# Enable FP16 precision (Recommended for NVIDIA GPUs, set to false for CPU)
ECHOKEEPER_FP16=true

# ── Hugging Face (Required for 'opus' backend)
HF_API_TOKEN=your_huggingface_token_here

# ── Discord Bot Settings
# Comma-separated list of channel IDs for automatic translation
AUTO_TRANSLATE_CHANNELS=

# Default target language if user hasn't set a preference
DEFAULT_TARGET_LANG=en
